#!/bin/bash
# stub compiler/assembler/ampp for the c cases of edge.sh: log the argv
# to $CLOG, with the tree path (VERIFY_CTREE) replaced by CTREE and
# edge.sh's OUTDIR (VERIFY_OUT) by OUT (literally, nothing else is masked)
line="$(basename "$0") $*"
[ -n "$VERIFY_CTREE" ] && line=${line//"$VERIFY_CTREE"/CTREE}
[ -n "$VERIFY_OUT" ] && line=${line//"$VERIFY_OUT"/OUT}
printf '%s\n' "$line" >> "$CLOG"
exit 0
